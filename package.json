  "license": "MIT",
  "dependencies": {
    "@nimiq/core": "^2.21.0",
    "@nimiq/mini-app-sdk": "^0.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
