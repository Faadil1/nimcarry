{
  "name": "nimcarry",
  "version": "1.0.0",
  "private": true,
  "description": "NimCarry - destination-bound human routing through consenting 1 NIM bridges",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo:local": "tsx scripts/demo-local.ts",
    "generate:wallet": "tsx scripts/generate-wallet.ts",
    "generate:secondary": "tsx scripts/generate-secondary-wallet.ts",
    "fund:wallet": "tsx scripts/fund-wallet.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:judge": "node scripts/judge-smoke.mjs"
  },
  "keywords": [],
